    title = {Timor-Leste survey word lists},
    location = {Bunak Maliana: Tapo (Maliana) (3,5 hours from Dili), Tokodede: Mauboke (west of Liquiça, 1 hour from Dili), Tetun Dili: Dili, Mambae: Ainaro (4 hours from Dili), Kemak: Atabai (2 hours from Dili), Idate: Kalohan (desa Bora Mane Lima, close to Laclubar, 3,5 hours from Dili), Lakalei: desa Fahinehan (close to Alas, 7.5 hours from Dili)},
    collector = {Marian Klamer},

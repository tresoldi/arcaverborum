    assistant = {Bunak Maliana: Domingus Belo da Cruz – student, 20+ years old, Tokodede: Maria Pareira Lobato - student, 26 years old, Mambae: Jorge de Orleans – student, 20+ years old, Kemak: Alfredo Tawares - student, 25 years old},
    speaker = {Bunak Maliana: Domingus Martin [DM] – 24 years old, teacher at SMP. Speaks Tetum, Indonesian, Portuguese and English. Tokodede: Mario Ataidi do Rego [MAR] – 70 years old, farmer, illiterate. Speaks Tetum, a little Indonesian and Portuguese. Tetun Dili: Erçilio Freitas da Costa [EFC] – 28 years old. Does not speak any local vernacular besides Tetun Dili. Speaks Indonesian, and a little English. Born in Viqueque, grew up in Dili. Lives in Dili, Santa Cruz. Highest education SMA, in training as policeman. Worked as driver and assisted in the interviews during the surveys. Mambae: Cesario Magno Sarmento [CMS] – 54 years old, director Presecondaria (SMP), speaks Indonesian and Portuguese fluently. Kemak: Alfredo Manuel Leite [AML] – 48 years old, also speaks Tetum and Indonesian. Idate: Louis Soares [LS] – 24 years old, nurse. Lakalei: Domingus Pinto [DP] – 30 years, university graduate, teacher at Lyceu (‘SMA’), also speakers of Mambai},
    orthographic_profile = {p/ipa-cleanup},
    note = {Unpublished word lists}
